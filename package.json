{
  "name": "ally-sheet-viewer",
  "version": "0.0.0",
  "scripts": {
    "schemas:snapshot": "node scripts/snapshot-content-schemas.mjs",
    "schemas:generate": "node scripts/generate-content-schemas.mjs",
    "schemas:check": "node scripts/generate-content-schemas.mjs --check",
    "schemas:audit": "node scripts/audit-content-contracts.mjs",
    "test:schemas": "node --test scripts/content-schema-tooling.test.mjs",
    "pretest:schemas": "npm run schemas:generate",
    "config": "node scripts/generate-runtime-config.mjs",
    "prestart": "npm run config && npm run schemas:generate",
    "prebuild": "npm run config && npm run schemas:generate",
    "prewatch": "npm run config && npm run schemas:generate",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "deploy": "node scripts/deploy-pages.mjs",
    "deploy:prepare": "node scripts/deploy-pages.mjs --prepare-only",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/run-tests.mjs quick",
    "test:rules": "firebase emulators:exec --only database --project demo-dice-ally \"node scripts/test-database-rules.mjs\"",
    "test:changed": "node scripts/run-tests.mjs changed",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:ui": "node scripts/run-tests.mjs ui",
    "test:all": "node scripts/run-tests.mjs all",
    "test:tools": "node scripts/test-workflow.test.mjs && node scripts/retain-release-assets.test.mjs",
    "schemas:ensure": "node scripts/ensure-content-schemas.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "firebase": "^13.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.25",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "angular-cli-ghpages": "^3.1.2",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "^15.34.1",
    "jsdom": "^29.1.1",
    "number-precision": "1.6.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    },
    "re2": "^1.27.0"
  }
}
