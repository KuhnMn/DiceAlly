{
  "name": "ally-sheet-viewer",
  "version": "0.0.0",
  "scripts": {
    "schemas:snapshot": "node scripts/snapshot-content-schemas.mjs",
    "schemas:generate": "node scripts/generate-content-schemas.mjs",
    "schemas:check": "node scripts/generate-content-schemas.mjs --check",
    "schemas:audit": "node scripts/audit-content-contracts.mjs",
    "test:schemas": "node --test scripts/content-schema-tooling.test.mjs",
    "pretest:schemas": "npm run schemas:generate",
    "config": "node scripts/generate-runtime-config.mjs",
    "prestart": "npm run config && npm run schemas:generate",
    "prebuild": "npm run config && npm run schemas:generate",
    "prewatch": "npm run config && npm run schemas:generate",
    "pretest": "npm run schemas:generate",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "deploy": "node scripts/deploy-pages.mjs",
    "deploy:prepare": "node scripts/deploy-pages.mjs --prepare-only",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:rules": "firebase emulators:exec --only database --project demo-dice-ally \"node scripts/test-database-rules.mjs\"",
    "serve:ssr:AllySheetViewer": "node dist/AllySheetViewer/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/cdk": "^21.2.3",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "^21.2.3",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.4",
    "express": "^5.1.0",
    "firebase": "^13.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "angular-cli-ghpages": "^3.0.2",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.34.0",
    "jsdom": "^27.1.0",
    "number-precision": "1.6.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
