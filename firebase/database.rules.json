{
  "rules": {
    ".read": false,
    ".write": false,
    "characterShares": {
      "$code": {
        ".read": "auth != null && root.child('members').child(auth.uid).val() === true && data.exists() && data.child('expiresAt').val() > now",
        ".write": "auth != null && root.child('members').child(auth.uid).val() === true && ((!data.exists() && newData.child('ownerUid').val() === auth.uid && $code.matches(/^[a-f0-9]{24}$/)) || (data.child('ownerUid').val() === auth.uid && !newData.exists()))",
        ".validate": "newData.hasChildren(['ownerUid', 'characterId', 'createdAt', 'expiresAt', 'character'])",
        "ownerUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "characterId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 300000" },
        "expiresAt": { ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 86400000" },
        "character": {
          ".validate": "newData.hasChildren(['meta', 'body'])",
          "meta": {
            ".validate": "newData.hasChildren(['revision', 'hash', 'updatedAt', 'deleted'])",
            "revision": { ".validate": "newData.val() === 1" },
            "hash": { ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)" },
            "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "deleted": { ".validate": "newData.val() === false" },
            "$other": { ".validate": false }
          },
          "body": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8000000" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).val() === true",
        "settings": {
          "$key": {
            ".write": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).val() === true && ($key === 'theme' || $key === 'sourceBooks') && newData.exists()",
            ".validate": "newData.hasChildren(['value', 'mutationId'])",
            "value": { ".validate": "newData.isString() && newData.val().length <= 32000" },
            "mutationId": { ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9-]{36}$/)" },
            "$other": { ".validate": false }
          }
        },
        "characters": {
          "$characterId": {
            ".write": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).val() === true && newData.exists() && ((!data.exists() && newData.child('meta/revision').val() === 1) || (data.exists() && newData.child('meta/revision').val() === data.child('meta/revision').val() + 1))",
            ".validate": "newData.hasChildren(['meta', 'body'])",
            "meta": {
              ".validate": "newData.hasChildren(['revision', 'hash', 'updatedAt', 'deleted'])",
              "revision": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0" },
              "hash": { ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)" },
              "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "deleted": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            },
            "body": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8000000" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
